[Unit]
Description=FairCom Prometheus Exporter
Documentation=https://github.com/faircom/prometheus-exporter
After=network.target

[Service]
Type=simple
User=faircom
Group=faircom
ExecStart=/usr/local/bin/faircom_exporter --config /etc/faircom_exporter/config.yaml
Restart=on-failure
RestartSec=5s

# Create log directory on startup
RuntimeDirectory=faircom_exporter
LogsDirectory=faircom_exporter

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/faircom_exporter

[Install]
WantedBy=multi-user.target
